# Sector 7-G template — copy to the app repo as .devcontainer/local.env.example,
# then tailor the variable list to what this repo's config/deploy*.yml reads.
#
# Add `.devcontainer/local.env` to .gitignore in the same commit. Delete this
# header block when done.
# ---------------------------------------------------------------------------
# Copy to .devcontainer/local.env (gitignored) to run read-only Kamal commands
# such as `kamal config` from inside the devcontainer.
#
# NON-SECRET VALUES ONLY. Never add SECRET_KEY_BASE, DATABASE_URL, POSTGRES_PASSWORD,
# session/encryption keys or any API token: a compromised container would hand over
# production. Deploys run in CI, which has the secrets.
#
# Anything derivable from the git remote (repo slug, owner) is handled by
# kamal-env.sh and is not listed here.

# VPS the deploy targets — the production GitHub Environment variable HOST_IP.
HOST_IP=

# Public hostnames the proxy config interpolates, if this repo's deploy config
# reads them. Mirror the production GitHub Environment variables.
# WEB_URL=
# API_URL=
